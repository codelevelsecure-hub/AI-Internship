OPENAI_API_KEY=

# Pinecone (Session 2 RAG) — get the key from app.pinecone.io > API Keys
PINECONE_API_KEY=
# Index must be created with dimension 1536, metric cosine (text-embedding-3-small)
PINECONE_INDEX_NAME=ask-rag
# Optional — groups your vectors inside the index; defaults to "default"
PINECONE_NAMESPACE=default

# Optional — /ingest chunking, in characters (defaults 800 / 100)
CHUNK_SIZE=800
CHUNK_OVERLAP=100
