OPENAI_API_KEY=

# Pinecone — get the key from app.pinecone.io > API Keys
PINECONE_API_KEY=
# Index must be created with dimension 1536, metric cosine (text-embedding-3-small): python create_pinecone_index.py
PINECONE_INDEX_NAME=tailabs-ask-rag
# Two namespaces in the index keep the corpora apart (defaults shown)
PINECONE_NAMESPACE_STANDARDS=project-1-standards
PINECONE_NAMESPACE_ORG=project-1-org-default

# API key clients must send as X-API-Key. Leave empty for local use; ALWAYS set it on a deployed server.
API_KEY=

# Optional model overrides (defaults shown)
ROUTER_MODEL=gpt-4o
GAP_MODEL=gpt-4o-mini

# Optional — chunking for ad-hoc POST /ingest documents, in characters (defaults 800 / 100)
CHUNK_SIZE=800
CHUNK_OVERLAP=100
